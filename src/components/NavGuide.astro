---
// Обяснителна схема, нарисувана от мен (не е изпитна картинка). Формулите са от верните отговори на изпита.
const cx = 170, cy = 170, R = 120;
const pt = (deg: number, r: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)] as const;
};
const arc = (from: number, to: number, r: number) => {
  const [x1, y1] = pt(from, r), [x2, y2] = pt(to, r);
  return `M${x1.toFixed(1)} ${y1.toFixed(1)} A${r} ${r} 0 ${to - from > 180 ? 1 : 0} 1 ${x2.toFixed(1)} ${y2.toFixed(1)}`;
};
const HDG = 55, BRG = 125;
const [hx, hy] = pt(HDG, R + 18), [bx, by] = pt(BRG, R + 18), [nx, ny] = pt(0, R + 18);
const [t1x, t1y] = pt(HDG / 2, 70), [t2x, t2y] = pt(BRG / 2 + 8, 44), [t3x, t3y] = pt((HDG + BRG) / 2, 96);
const [ox, oy] = pt(BRG, R - 10);
---
<div class="fig">
  <svg viewBox="0 0 420 340" role="img" aria-label="Схема: истински курс, истински пеленг и курсов ъгъл" xmlns="http://www.w3.org/2000/svg" style="max-height:none;background:none;max-width:460px;margin:0 auto;display:block">
    <circle cx={cx} cy={cy} r={R} fill="none" stroke="#0a6e8a" stroke-width="1.5" opacity=".5" />
    <line x1={cx} y1={cy} x2={nx} y2={ny} stroke="#0a6e8a" stroke-width="2" />
    <text x={nx} y={ny - 6} text-anchor="middle" font-size="14" font-weight="700" fill="#0a6e8a">N (север)</text>
    <line x1={cx} y1={cy} x2={hx} y2={hy} stroke="#b3105c" stroke-width="3" />
    <text x={hx + 4} y={hy - 4} font-size="12" font-weight="700" fill="#b3105c">курс на кораба</text>
    <line x1={cx} y1={cy} x2={bx} y2={by} stroke="#1c6e3a" stroke-width="2.5" stroke-dasharray="6 4" />
    <circle cx={ox} cy={oy} r="6" fill="#1c6e3a" />
    <text x={bx - 4} y={by + 16} text-anchor="middle" font-size="12" font-weight="700" fill="#1c6e3a">предмет</text>
    <path d={arc(0, HDG, 62)} fill="none" stroke="#b3105c" stroke-width="2.5" />
    <text x={t1x - 6} y={t1y - 4} font-size="14" font-weight="700" fill="#b3105c">ИК</text>
    <path d={arc(0, BRG, 38)} fill="none" stroke="#1c6e3a" stroke-width="2.5" />
    <text x={t2x + 10} y={t2y + 14} font-size="14" font-weight="700" fill="#1c6e3a">ИП</text>
    <path d={arc(HDG, BRG, 90)} fill="none" stroke="#7a4b00" stroke-width="2.5" />
    <text x={t3x + 6} y={t3y + 6} font-size="14" font-weight="700" fill="#7a4b00">КЪ</text>
    <circle cx={cx} cy={cy} r="5" fill="#122a3b" />
  </svg>
  <p class="meta">Корабът е в центъра. ИК и ИП се мерят от севера по часовниковата стрелка (0°–360°). КЪ е от посоката на движение към предмета и е вдясно (десен борд) в този пример.</p>
</div>
