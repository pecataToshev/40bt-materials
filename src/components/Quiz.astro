---
// Карта-връзка към отделна страница за теста (/test/).
interface Props { title?: string; topic?: string; ids?: number[]; count?: number; mode?: 'topic' | 'mistakes' | 'exam'; }
const { title = 'Тест', topic, ids, count = 10, mode = 'topic' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = new URLSearchParams();
p.set('mode', mode === 'exam' ? 'exam' : 'learn');
if (mode === 'mistakes') p.set('m', '1');
else if (ids) p.set('ids', ids.join(','));
else if (topic) p.set('t', topic);
if (mode !== 'mistakes') p.set('n', String(count));
p.set('title', title);
const href = `${base}/test/?${p.toString()}`;
const sub = mode === 'mistakes' ? 'Въпросите, които си сгрешил' : mode === 'exam' ? `${count} въпроса · време · без верните отговори до края` : `${count} въпроса · с верните отговори`;
---
<a class="quiz-card" href={href}>
  <strong>{title}</strong>
  <span class="meta">{sub}</span>
  <span class="go">Започни →</span>
</a>
