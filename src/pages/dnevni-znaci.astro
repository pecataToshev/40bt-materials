---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/svetlini/`;
---
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <title>Светлини и дневни знаци</title>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
  </head>
  <body><p>Страницата е преместена: <a href={to}>Светлини и дневни знаци</a>.</p></body>
</html>
