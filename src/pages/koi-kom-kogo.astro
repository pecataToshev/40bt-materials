---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
import QaSection from '../components/QaSection.astro';
const ladder: [string, string][] = [
  ['Кораб без управление', 'Всички му отстъпват'],
  ['Кораб с ограничена маневреност', 'Отстъпват му всички по-долу'],
  ['Кораб, ограничен от газенето си', 'Отстъпват му всички по-долу'],
  ['Кораб, зает с риболов', 'Отстъпват му ветроходни и моторни'],
  ['Ветроходен кораб', 'Отстъпва му моторният'],
  ['Моторен кораб на ход', 'Отстъпва на всички горе'],
];
---
<Base title="Кой отстъпва път" description="Йерархия на корабите, изпреварване, насрещни и пресичащи се курсове.">
  <div class="wrap">
    <h1>Кой отстъпва път</h1>
    <h2>Стълбата на предимството</h2>
    <p>Всеки кораб в списъка отстъпва път на корабите над него.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Кораб</th><th>Кой му отстъпва</th></tr></thead>
      <tbody>{ladder.map(([a, b], i) => <tr><td><strong>{i + 1}. {a}</strong></td><td>{b}</td></tr>)}</tbody>
    </table></div>
    <div class="note"><p>Изпреварващият кораб винаги отстъпва, дори да е по-горе в стълбата. Този, който е изпреварван, поддържа курс и скорост.</p></div>

    <h2>Видове ситуации</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Ситуация</th><th>Правило</th></tr></thead>
      <tbody>
        <tr><td><strong>Изпреварване</strong> (правило 13)</td><td>Приближаваш от повече от 22,5° зад траверса на другия. При съмнение считай, че изпреваряш. Изпреварващият отстъпва.</td></tr>
        <tr><td><strong>Насрещни курсове</strong> (правило 14)</td><td>И двата кораба завиват надясно и се разминават ляв борд с ляв борд.</td></tr>
        <tr><td><strong>Пресичащи се курсове</strong> (правило 15)</td><td>Отстъпва корабът, който има другия от <strong>десния си борд</strong>. Той избягва да пресича пред носа му.</td></tr>
        <tr><td><strong>Отстъпващият</strong> (правило 16)</td><td>Действа рано и решително.</td></tr>
        <tr><td><strong>Кораб с предимство</strong> (правило 17)</td><td>Поддържа курс и скорост.</td></tr>
        <tr><td><strong>Теснини</strong> (правило 9)</td><td>Дръж се възможно най-близо до десния край. Кораби под 20 м и ветроходните не затрудняват големите.</td></tr>
        <tr><td><strong>Схема за разделно движение</strong> (правило 10)</td><td>Движи се в коридора в общата посока и далеч от разделителната линия. Малките кораби (под 20 м), ветроходните и риболовните могат да ползват крайбрежната зона.</td></tr>
        <tr><td><strong>Ограничена видимост</strong> (правило 19)</td><td>Безопасна скорост, машината готова. Чуеш ли сигнал пред траверса, намали до минимума за управление.</td></tr>
      </tbody>
    </table></div>

    <h2>Схема за разделно движение (правило 10)</h2>
    <p>Схемата има коридори с посока на движение, разделителна зона или линия между тях и крайбрежна зона между последния коридор и брега.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Ситуация</th><th>Какво важи</th></tr></thead>
      <tbody>
        <tr><td><strong>В коридор</strong></td><td>Движиш се в подходящия коридор в общата посока на движение и по възможност стоиш далеч от разделителната линия или зона. Влизаш и излизаш обикновено в края на коридора. Ако е отстрани, под възможно най-малък ъгъл към посоката.</td></tr>
        <tr><td><strong>Пресичане на коридорите</strong></td><td>Избягва се, доколкото е възможно. Ако не може, пресичаш възможно най-близо до прав ъгъл.</td></tr>
        <tr><td><strong>Крайбрежна зона</strong></td><td>Не се ползва, ако можеш безопасно да ползваш коридора. Могат: кораби под 20 м, ветроходни и заети с риболов. Могат и кораби на път към или от пристанище, морско съоръжение или конструкция, пилотска станция или друго място в зоната. Могат и кораби, които избягват непосредствена опасност.</td></tr>
        <tr><td><strong>Разделителна зона или линия</strong></td><td>Обикновено не се влиза и не се пресича. Изключения: кораб, който пресича схемата или влиза или излиза от коридор, при непосредствена опасност и кораби, заети с риболов в разделителната зона.</td></tr>
        <tr><td><strong>Кораб, който не ползва схемата</strong></td><td>Държи се на възможно най-голямо разстояние от нея.</td></tr>
        <tr><td><strong>Котвена стоянка</strong></td><td>Избягва се в схемата и близо до краищата ѝ, доколкото е възможно.</td></tr>
        <tr><td><strong>Да не затрудняват</strong></td><td>Корабите, заети с риболов, кораби под 20 м и ветроходните не затрудняват кораба, който следва коридор.</td></tr>
        <tr><td><strong>Ограничен в способността да маневрира</strong></td><td>При работа за безопасността на плаването в схемата е освободен от правилото само дотолкова, доколкото е нужно за работата.</td></tr>
      </tbody>
    </table></div>
    <p class="meta">Източник: правило 10 от МППСМ (COLREG). Текст: <a href="https://cultofsea.com/colregs/part-b-steering-and-sailing-rules-4-19/rule-10-traffic-separation-schemes">Cult of Sea</a> и <a href="https://m.openjurist.org/33/usc/2010">33 USC 2010</a>.</p>

    <QaSection title="Още от изпита: светлини, радар и сигнали" ids={[430, 434, 435, 443, 444, 484, 485, 490, 509, 586]} />

    <h2>Тест</h2>
    <Quiz title="Правила за плаване" topic="pravila" count={10} />
  </div>
</Base>
