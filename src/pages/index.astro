---
import Base from '../layouts/Base.astro';
import { bank } from '../lib/bank';
const b = import.meta.env.BASE_URL;
const items: [string, string, string][] = [
  ['svetlini', 'Светлини', 'Нощни схеми на 37 комбинации: ход, влачене, котва, риболов.'],
  ['denoshni-znaci', 'Дневни знаци', 'Сфери, конуси, цилиндри, ромбове и флагове.'],
  ['zvukovi-signali', 'Звукови сигнали', 'Къси и продължителни звуци, мъгла, бедствие.'],
  ['buyove', 'Буйове и вехи', 'IALA Район A и B, кардинални знаци.'],
  ['vetrove', 'Ветрове', 'Диаграма: бейдевинд, халфвинд, бакщаг, фордевинд.'],
  ['vremeto', 'Времето', 'Признаци за добро и лошо време, уреди, вълнение.'],
  ['globi', 'Глоби и разпоредби', 'Суми, документи, зони, МАРПОЛ.'],
  ['koi-kom-kogo', 'Кой отстъпва път', 'Предимство, изпреварване, пресичане.'],
  ['testove', 'Тестове', `Всички ${bank.length} въпроса, симулация, повторение.`],
];
---
<Base title="Водач на кораб до 40 БТ" description="Материали за изпита за водач на кораб до 40 БТ по море.">
  <div class="wrap">
    <h1>Водач на кораб до 40 БТ по море</h1>
    <p>Материали за подготовка: светлини, знаци, сигнали, глоби, време и ветрове, с тестове по {bank.length} въпроса.</p>
    <div class="cards">
      {items.map(([p, t, d]) => <a class="card" href={`${b}${p}/`}><h3>{t}</h3><p>{d}</p></a>)}
    </div>
  </div>
</Base>
