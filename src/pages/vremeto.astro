---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
const good: string[] = [
  'Дълго високо налягане: устойчиво хубаво време',
  'През деня влажността намалява, вечерта се увеличава',
  'Чайките кацат и стоят по водата',
  'Птиците летят високо при дъжд: времето ще се подобри',
  'Денонощният ритъм на бриза е запазен: през деня от морето към брега',
];
const bad: string[] = [
  'Налягането пада: влошаване на времето',
  'Пурпурно небе при изгрев: вятър и дъжд',
  'Хало около Луната или Слънцето: вятър и дъжд',
  'Луната изгрява червена: ще има вятър',
  'Нощната температура е по-висока от дневната',
  'Бризът променя денонощния си ритъм',
  'Вечер вятърът се засилва и се завърта по часовниковата стрелка: щорм',
];
---
<Base title="Времето" description="Признаци за добро и лошо време, уреди, вятър и вълнение.">
  <div class="wrap">
    <h1>Времето</h1>
    <p>Местните признаци са начин за прогнозиране на времето без прибори. Всеки признак е подсказка, а не гаранция: най-надеждно е да следиш няколко едновременно.</p>

    <div class="weather-split">
      <div class="weather good"><h3>Добро време</h3><ul>{good.map((g) => <li>{g}</li>)}</ul></div>
      <div class="weather bad"><h3>Лошо време</h3><ul>{bad.map((g) => <li>{g}</li>)}</ul></div>
    </div>

    <h2>Уреди</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Какво се мери</th><th>Уред</th></tr></thead>
      <tbody>
        <tr><td>Сила на вятъра</td><td>Анемометър</td></tr>
        <tr><td>Атмосферно налягане</td><td>Барометър-анероид</td></tr>
        <tr><td>Влажност на въздуха</td><td>Аспирационен психрометър</td></tr>
        <tr><td>Денонощен ход на температурата</td><td>Термограф</td></tr>
      </tbody>
    </table></div>

    <h2>Вятър</h2>
    <div class="table-wrap"><table>
      <tbody>
        <tr><th>Причина</th><td>Разлика в атмосферното налягане между точките на земното кълбо</td></tr>
        <tr><th>Посока</th><td>Посоката, от която идва; отчита се по румбовата система</td></tr>
        <tr><th>Сила</th><td>Скала на Бофорт: от 0 до 12 бала</td></tr>
        <tr><th>Измерен на движещ се кораб</th><td>Относителен (привиден) вятър</td></tr>
        <tr><th>Бриз през деня</th><td>От морето към брега</td></tr>
        <tr><th>Шквал</th><td>Неочаквано краткотрайно усилване на вятъра</td></tr>
      </tbody>
    </table></div>

    <h2>Вълнение и течения</h2>
    <div class="table-wrap"><table>
      <tbody>
        <tr><th>Посока на вълнението</th><td>Посоката, от която идват вълните</td></tr>
        <tr><th>Скала на вълнението</th><td>От 0 до 9 бала</td></tr>
        <tr><th>Зиб (мъртъв зиб)</th><td>Вълнение, което вече не е под въздействието на вятъра</td></tr>
        <tr><th>Прибой</th><td>Връхлитане на вълните върху стръмни и отвесни брегове</td></tr>
        <tr><th>Буруни</th><td>Разрушаване на вълните върху плитчини на разстояние от брега</td></tr>
        <tr><th>Морски течения</th><td>Преместване на водни маси; релефът на дъното и очертанията на брега влияят на теченията</td></tr>
      </tbody>
    </table></div>

    <h2>Бряг и ориентири</h2>
    <div class="table-wrap"><table>
      <tbody>
        <tr><th>Нос Калиакра</th><td>Висок и скалист, почвата и скалите са червени</td></tr>
        <tr><th>Нос Емине</th><td>Висок, стръмен бряг, пластовете са наклонени, почвата е бяла</td></tr>
        <tr><th>Н. Екрене – КК „Албена“</th><td>Пясък, плажове</td></tr>
        <tr><th>Аладжа банка</th><td>Пред КК „Златни пясъци“; плаващият знак огражда опасността от изток</td></tr>
        <tr><th>Фар Екрене</th><td>На север от КК „Златни пясъци“</td></tr>
        <tr><th>Нос Свети Атанас</th><td>На юг от р. Камчия</td></tr>
        <tr><th>Магнитна аномалия</th><td>Бургаски залив</td></tr>
      </tbody>
    </table></div>

    <h2>Тест</h2>
    <Quiz title="Времето и районът" topic="vreme" count={10} />
  </div>
</Base>
