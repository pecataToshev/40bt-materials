---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
const fines: [string, string][] = [
  ['Указания на Трафик-контрола в районите на пристанищата', '1 000 – 2 500'],
  ['Правила за използване на котвените стоянки', '1 000 – 2 500'],
  ['Правила за радиообмена', '500 – 5 000'],
  ['Правила за пожарна безопасност', '500 – 5 000'],
  ['Правила за предпазване на морето от замърсяване', '10 000 – 50 000'],
  ['Наредби по прилагането на КТК (№ 1, № 5 и др.), ако няма друга санкция', '400 – 2 000'],
];
---
<Base title="Глоби и разпоредби" description="Глобите по КТК от изпитния ключ, документи, зони и опазване на морето.">
  <div class="wrap">
    <h1>Глоби и разпоредби</h1>
    <p>Сумите са в лева и са взети от верните отговори в изпитната банка. Провери ги спрямо действащия Кодекс на търговското корабоплаване.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Нарушение</th><th>Глоба (лв.)</th></tr></thead>
      <tbody>{fines.map(([a, b]) => <tr><td>{a}</td><td><strong>{b}</strong></td></tr>)}</tbody>
    </table></div>

    <h2>Документи и регистрация</h2>
    <div class="table-wrap"><table>
      <tbody>
        <tr><th>Малък кораб</th><td>До 40 БТ</td></tr>
        <tr><th>Документ за собственост</th><td>Свидетелство за регистрация</td></tr>
        <tr><th>Кой го издава</th><td>Изпълнителният директор на „Морска администрация“ (дирекции Варна и Бургас за морски, Русе и Лом за речни кораби)</td></tr>
        <tr><th>Купен в чужбина</th><td>Временно свидетелство за плаване под знамето на Р. България; заявяване за вписване до 6 седмици след първото българско пристанище</td></tr>
        <tr><th>Вид на корабните документи</th><td>Наредба № 5</td></tr>
        <tr><th>Регистрация и квалификация на морските лица</th><td>Наредба № 6</td></tr>
        <tr><th>Корабен дневник</th><td>Не е задължителен за кораб до 40 БТ без стопанска дейност, когато районът на плаване е под 5 мили</td></tr>
        <tr><th>Документи се съхраняват</th><td>На борда</td></tr>
        <tr><th>Пристанище на регистрация</th><td>Означава се на кърмата или на бордовете в кърмовата част</td></tr>
      </tbody>
    </table></div>

    <h2>Водач на кораб до 40 БТ по море</h2>
    <div class="table-wrap"><table>
      <tbody>
        <tr><th>Минимална възраст</th><td>18 години</td></tr>
        <tr><th>Минимално образование</th><td>Основно</td></tr>
        <tr><th>Права</th><td>Капитан на кораб до 40 БТ, който превозва до 12 души на борда, включително екипажа</td></tr>
      </tbody>
    </table></div>

    <h2>Морски зони</h2>
    <div class="table-wrap"><table>
      <tbody>
        <tr><th>Териториално море</th><td>12 морски мили от изходните линии</td></tr>
        <tr><th>Прилежаща зона</th><td>До 24 морски мили от изходните линии</td></tr>
        <tr><th>Контрол в прилежащата зона</th><td>Митнически, финансови, гранични и санитарни нарушения</td></tr>
        <tr><th>Спасителна дейност на юг от нос Емине</th><td>ГД „Аварийно спасителна дейност“</td></tr>
        <tr><th>Правомощия на ДМА Бургас</th><td>От паралела на нос Емине до границата с Турция</td></tr>
      </tbody>
    </table></div>

    <h2>Замърсяване (МАРПОЛ)</h2>
    <div class="note">
      <p>Пластмасите в морето са абсолютно забранени.</p>
      <p>Черно море е „специална зона“ по Анекс V. Отпадъците се сдават в пристанище.</p>
    </div>

    <h2>При авария</h2>
    <div class="note"><p>Екипажът остава заедно в района, защото спасителите започват търсене от последната известна позиция. Капитанът спасява корабния дневник, картите на рейса, ценностите и документите.</p></div>

    <h2>Тест</h2>
    <Quiz title="Закони, глоби, документи" topic="zakon" count={10} />
  </div>
</Base>
