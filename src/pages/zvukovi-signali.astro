---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
import { seqSvg } from '../lib/shapes';
import { distress } from '../lib/distress';
const maneuver: [string, string][] = [
  ['.', 'Завивам надясно'],
  ['..', 'Завивам наляво'],
  ['...', 'Машината ми работи на заден ход'],
  ['.....', 'Съмнение или опасност: не разбирам намеренията ти'],
  ['-', 'Приближавам завой или място, закрито от препятствие'],
];
const overtaking: [string, string][] = [
  ['-- .', 'Искам да те изпреваря по десния ти борд'],
  ['-- ..', 'Искам да те изпреваря по левия ти борд'],
  ['-.-.', 'Съгласен съм с изпреварването'],
];
const fog: [string, string][] = [
  ['-', 'Моторен кораб, който се движи относно водата'],
  ['--', 'Моторен кораб, който не е на котва, но е спрял и няма скорост относно водата'],
  ['-..', 'Кораб без управление'],
  ['-..', 'Кораб с ограничена маневреност'],
  ['-..', 'Кораб, ограничен от газенето си'],
  ['-..', 'Ветроходен кораб'],
  ['-..', 'Кораб, зает с риболов'],
  ['-..', 'Кораб, който влачи или тласка'],
  ['-...', 'Влачен кораб (последният, ако е с екипаж)'],
  ['....', 'Пилот на ход'],
];
---
<Base title="Звукови сигнали" description="Маневрени, изпреварващи и мъгленосни сигнали с визуален запис на продължителни и къси звуци.">
  <div class="wrap">
    <h1>Звукови сигнали</h1>
    <p>Къс звук е около 1 секунда (<span class="morse" set:html={seqSvg('.')}></span>), продължителен е 4–6 секунди (<span class="morse" set:html={seqSvg('-')}></span>).</p>

    <h2>Маневрени сигнали (правило 34)</h2>
    <p>Подават се само когато корабите се виждат един друг.</p>
    <div class="sound-list">
      {maneuver.map(([s, t]) => <div class="sound-row"><span class="morse" set:html={seqSvg(s)}></span><span>{t}</span></div>)}
    </div>

    <h2>Теснини: изпреварване</h2>
    <div class="sound-list">
      {overtaking.map(([s, t]) => <div class="sound-row"><span class="morse" set:html={seqSvg(s)}></span><span>{t}</span></div>)}
    </div>
    <div class="note"><p>В теснина или фарватер, когато чуеш един продължителен звук, отговаряш с един продължителен звук.</p></div>

    <h2>Ограничена видимост (правило 35)</h2>
    <p>Сигналите се подават през интервал не по-голям от 2 минути.</p>
    <div class="sound-list">
      {fog.map(([s, t]) => <div class="sound-row"><span class="morse" set:html={seqSvg(s)}></span><span>{t}</span></div>)}
    </div>

    <h2>Камбана и гонг</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Кораб</th><th>Сигнал</th></tr></thead>
      <tbody>
        <tr><td>На котва, под 100 м</td><td>Бърза камбана около 5 секунди, поне веднъж на минута</td></tr>
        <tr><td>На котва, над 100 м</td><td>Камбана на носа, след нея гонг на кърмата</td></tr>
        <tr><td>На котва и може да подаде предупредителен сигнал</td><td>Един къс, един продължителен и един къс звук</td></tr>
        <tr><td>Заседнал</td><td>Три отделни удара на камбаната преди и след бързата камбана</td></tr>
      </tbody>
    </table></div>

    <h2>Малки кораби</h2>
    <div class="note"><p>Кораб под 12 м не е длъжен да подава сигналите по правилата за ограничена видимост. Той трябва да подава друг ефективен звуков сигнал през интервал по-малък от 2 минути.</p><p>Ако свирките са на повече от 100 м една от друга, подава се само една от тях.</p></div>

    <h2>Сигнали за бедствие</h2>
    <div class="grid">
      {distress.map((d) => (
        <figure class="fig"><Fragment set:html={d.svg()} /><figcaption><strong>{d.title}</strong><span>{d.note}</span></figcaption></figure>
      ))}
    </div>

    <h2>Тест</h2>
    <Quiz title="Звукови сигнали" topic="zvuk" count={10} />
  </div>
</Base>
